# --- Database (Turso / libSQL) ---
# Remote Turso database:
TURSO_DATABASE_URL="libsql://your-database-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
# Local development without Turso: point at a SQLite file (absolute path, no token needed)
# TURSO_DATABASE_URL="file:/absolute/path/to/dev.db"

# --- Authentication (NextAuth v4) ---
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-the-same-secret-for-v4-compat"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth (enabled only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OpenAI ---
OPENAI_API_KEY=""
# Optional model overrides (defaults shown)
# Text generation (Chat Completions): lessons, tutor replies, review words, travel mode
# OPENAI_TEXT_MODEL="gpt-6-luna"
# Reasoning effort for text generation: none | minimal | low | medium | high | xhigh | max.
# "none" keeps replies fast and keeps temperature in use; set "off" to leave the parameter out
# for a model that does not accept it.
# OPENAI_TEXT_REASONING_EFFORT="none"
# Listen button. Speech is generated through the Realtime API, so this must be a Realtime model
# (the old Speech API models tts-1 / gpt-4o-mini-tts are not supported).
# OPENAI_TTS_MODEL="gpt-realtime-2.1-mini"
# Realtime voices: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# OPENAI_TTS_VOICE="marin"
# Chat microphone (file transcription)
# OPENAI_TRANSCRIPTION_MODEL="gpt-transcribe"
# Vocabulary pictures (Images API). Quality and size are passed through as-is.
# OPENAI_IMAGE_MODEL="gpt-image-2.6-flare"
# OPENAI_IMAGE_QUALITY="low"
# OPENAI_IMAGE_SIZE="1024x1024"
# Planning effort (low | medium | high). Defaults to "low" for gpt-image-2.6 models and is not sent
# for other models; set to "off" to never send it.
# OPENAI_IMAGE_COMPLEXITY="low"
# Voice conversation and travel mode (Realtime API over WebRTC)
OPENAI_REALTIME_MODEL="gpt-realtime-2.1"
OPENAI_REALTIME_VOICE="alloy"
# gpt-transcribe or gpt-live-transcribe (whisper-1, gpt-4o-transcribe and gpt-4o-mini-transcribe
# are still accepted until OpenAI shuts them down on Feb 26, 2027)
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-transcribe"

# --- Per-user daily AI limits (optional; defaults shown, a value <= 0 removes the cap) ---
# AI_DAILY_LIMIT_TEXT="400"
# AI_DAILY_LIMIT_SPEECH="300"
# AI_DAILY_LIMIT_TRANSCRIPTION="300"
# AI_DAILY_LIMIT_REALTIME="30"
# AI_DAILY_LIMIT_IMAGE="40"

# --- Vocabulary pictures (optional; defaults shown) ---
# "off" turns pictures off entirely (none generated or shown)
# LESSON_IMAGES="on"
# New pictures started per lesson, and how long a new lesson waits for them (ms)
# LESSON_IMAGES_PER_LESSON="4"
# LESSON_IMAGES_WAIT_MS="10000"
